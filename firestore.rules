rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Replace YOUR_EMAIL@gmail.com with the Google account you log in with.
// Only that account can read or write its own progress; everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "YOUR_EMAIL@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['progress', 'days', 'updatedAt'])
        && d.progress is map && d.progress.size() <= 20000
        && d.days is map && d.days.size() <= 200
        && d.updatedAt is int;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSave();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
